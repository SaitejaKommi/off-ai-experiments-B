flowchart TB
    U[User on Open Food Facts Product Page]
    E[Browser Extension Popup UI]
    BG[Background Service Worker\nlatest_barcode in chrome.storage.local]

    subgraph B[Backend]
        API[FastAPI Service\nPOST /product-insights]
        F[Product Fetcher\nfetch_product(barcode)]
        D[DuckDB Data Layer\npersistent off.duckdb connection]
        V[products View\nCanada-only filtering]
        A[Insight Engine\nrisk and positive indicators]
        R[Recommendation Engine\nweighted nutrition ranking]
        L[LLM Layer\nGroq Llama 3.3 70B\nsummary + score explanation + pairings]
        C[Response Composer\nstructured JSON response]
    end

    P[(OFF Parquet Dataset\noff_dev.parquet / food.parquet)]

    U --> E
    E --> BG
    E --> API

    API --> F
    F --> D
    D --> V
    V --> P

    API --> A
    API --> R
    API --> L

    F --> A
    F --> R
    F --> L

    A --> C
    R --> C
    L --> C

    C --> API
    API --> E

